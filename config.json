{
    "Paths": {
        "Shaders": "",
        "Saves": "",
        "GameData": "",
        "GraphicsOverrides": ""
    },
    "Graphics": {
        // Integer logical-canvas scale (320x200 * UiScale). 3..6 typical; clamped to monitor.
        "UiScale": 4,
        // "Windowed" | "BorderlessFullscreen" | "ExclusiveFullscreen"
        "WindowMode": "Windowed",
        "Fullscreen": {
            "Monitor": 0,
            "AutoScale": true
        },
        "VSync": true,
        // DEPRECATED: kept for back-compat. If UiScale is absent it is derived from this.
        "ResolutionScale": 4.0,
        "EnableShadows": true,
        "EnableImGui": false,
        "DrawDistance": 128000,
        "DebugDisableFades": false,
        "DebugRenderEncounters": false
    },
    "Audio": {
        // ADLMIDI | OPNMIDI | FluidSynth
        "MidiPlayer": "ADLMIDI",
        "EnableAudio": true,
        "EnableBackgroundSounds": true 
    },
    "Game": {
        "AdvanceTime": true,
        // Set this to true to fix the combat entity lists in the game
        // Note: the lists in the original are bugged, so this fixes it
        // but if you care about fidelity to the original leave this off
        "FixCombatEntityLists": false
    },
    "Logging": {
        "LogToFile": true,
        "LogTime": true,
        "LogColours": true,
        "LogFilePath": "",
        // SPAM | DEBUG | INFO | WARN | ERROR | FATAL
        "LogLevel": "DEBUG",
        "DisabledLoggers": [
            "Compass",
            "DialogStore",
            "LoadEncounter",
            "LoadFixedObjects",
            "LoadSceneIndices",
            "LoadScenes",
            "MeshObjectStore",
            "GameData",
            "Gui::StaticTTM",
            "GuiRenderer",
            "Gui::DialogRunner",
            "Gui::DialogDisplay",
            "Gui::AnimatorStore",
            "TeleportFactory",
            "FMAP_TWN",
            "FMAP",
            "CampData",
            "CreateFileBuffer"
        ]
    }
}
